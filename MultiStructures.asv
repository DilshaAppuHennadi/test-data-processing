%% Open and Plot All Data for a Single Crystal Type
%
%

clear all
close all

set(groot, 'DefaultAxesFontSize', 20);
set(groot, 'DefaultTextFontSize', 24);
set(groot, 'DefaultLegendFontSize', 18);

r = 118;%108;%
a = 390;
n = 25;
copy = 0;

%% Obtain system loss as a function of wavelength

SysLoss = OpenDAT('NRC_sys_losses/1460-1638-1mW-fiber-to-fiber-coupling.dat');

SysLoss_smoothed = movmean(SysLoss(:,2), 250);

figure
hold on
plot(SysLoss(:,1),SysLoss(:,2), 'LineWidth', 2)
plot(SysLoss(:,1), SysLoss_smoothed, 'r-', 'LineWidth', 2)
hold off
title('System Loss for TE')
xlabel('Wavelength (nm)')
ylabel('Loss (dB)')
legend('Raw data', 'Averaged data')

% Calculate wg length
Lwg = wgLength(a, n); %mm
TElosses = 'Per_Chip_Losses/lossesTE_silica1.dat';
TMlosses = 'Per_Chip_Losses/lossesTM_silica1.dat';

% Obtain waveguide and insertion losses for chip (NRC cladding)
% Data already compensated for system loss
[TE_wg_NRC,TE_in_NRC,TM_wg_NRC,TM_in_NRC,cutOff] = LossesTETM(Lwg, TElosses, TMlosses);
TE_wg_NRC = TE_wg_NRC(1:cutOff);
TE_in_NRC = TE_in_NRC(1:cutOff);
TM_wg_NRC = TM_wg_NRC(1:cutOff);
TM_in_NRC = TM_in_NRC(1:cutOff);

SysLoss_NRC = SysLoss(1:cutOff, :);
SysLoss_NRC_smoothed = SysLoss_smoothed(1:cutOff, :);

% Silica-cladding from NRC
folder = 'Jul_03_2026';

latticeParams = strcat('a=',string(a),'nm, r=',string(r),'nm, n_x=',string(n));

%% Plot data from chips cladded at NRC

% Import pure PhC data
fileName = strcat(folder,'/PhC/a',string(a),'_r',string(r),'_nx',string(n),'_',string(copy),'/PHC_A',string(a),'NM_R',string(r),'NM_N',string(n),'_TE_',string(copy),'.dat');
PhC_TE_NRC = OpenDAT(fileName);
PhC_TE_NRC = PhC_TE_NRC(1:cutOff, :);

fileName = strcat(folder,'/PhC/a',string(a),'_r',string(r),'_nx',string(n),'_',string(copy),'/PHC_A',string(a),'NM_R',string(r),'NM_N',string(n),'_TM_',string(copy),'.dat');
PhC_TM_NRC = OpenDAT(fileName);
PhC_TM_NRC = PhC_TM_NRC(1:cutOff, :);

% Import W1 data
fileName = strcat(folder,'/PBG/a',string(a),'_r',string(r),'_nx',string(n),'_',string(copy),'/W1_A',string(a),'NM_R',string(r),'NM_N',string(n),'_TE_',string(copy),'.dat');
W1_TE_NRC = OpenDAT(fileName);
W1_TE_NRC = W1_TE_NRC(1:cutOff, :);

fileName = strcat(folder,'/PBG/a',string(a),'_r',string(r),'_nx',string(n),'_',string(copy),'/W1_A',string(a),'NM_R',string(r),'NM_N',string(n),'_TM_',string(copy),'.dat');
W1_TM_NRC = OpenDAT(fileName);
W1_TM_NRC = W1_TM_NRC(1:cutOff, :);

% Import PBS data
fileName = strcat(folder,'/PBS/PBS_a',string(a),'_r',string(r),'_nx',string(n),'_',string(copy),'/PBS_A',string(a),'NM_R',string(r),'NM_N',string(n),'_TE_DIR_',string(copy),'.dat');
TEdir_NRC = OpenDAT(fileName);
TEdir_NRC = TEdir_NRC(1:cutOff, :);

fileName = strcat(folder,'/PBS/PBS_a',string(a),'_r',string(r),'_nx',string(n),'_',string(copy),'/PBS_A',string(a),'NM_R',string(r),'NM_N',string(n),'_TE_ADJ_',string(copy),'.dat');
TEadj_NRC = OpenDAT(fileName);
TEadj_NRC = TEadj_NRC(1:cutOff, :);

fileName = strcat(folder,'/PBS/PBS_a',string(a),'_r',string(r),'_nx',string(n),'_',string(copy),'/PBS_A',string(a),'NM_R',string(r),'NM_N',string(n),'_TM_DIR_',string(copy),'.dat');
TMdir_NRC = OpenDAT(fileName);
TMdir_NRC = TMdir_NRC(1:cutOff, :);

fileName = strcat(folder,'/PBS/PBS_a',string(a),'_r',string(r),'_nx',string(n),'_',string(copy),'/PBS_A',string(a),'NM_R',string(r),'NM_N',string(n),'_TM_ADJ_',string(copy),'.dat');
TMadj_NRC = OpenDAT(fileName);
TMadj_NRC = TMadj_NRC(1:cutOff, :);

[TE_W1, TM_W1] = plotData(SysLoss_NRC, TE_wg_NRC,TE_in_NRC,TM_wg_NRC,TM_in_NRC, PhC_TE_NRC, PhC_TM_NRC, W1_TE_NRC, W1_TM_NRC, latticeParams);
close all
plotPBSData(SysLoss_NRC, TE_wg_NRC,TE_in_NRC,TM_wg_NRC,TM_in_NRC, TEdir_NRC, TEadj_NRC, TMdir_NRC, TMadj_NRC, latticeParams, TE_W1, TM_W1);
close all

%% Now look at the measurements from the completed chips from AMF

TElosses = 'Per_Chip_Losses/lossesTE_silica_AMF_0.dat';
TMlosses = 'Per_Chip_Losses/lossesTM_silica_AMF_0.dat';

% Waveguide losses
[TE_wg_AMF,TE_in_AMF,TM_wg_AMF,TM_in_AMF,cutOff] = LossesTETM(Lwg, TElosses, TMlosses);
TE_wg_AMF = TE_wg_AMF(1:cutOff);
TE_in_AMF = TE_in_AMF(1:cutOff);
TM_wg_AMF = TM_wg_AMF(1:cutOff);
TM_in_AMF = TM_in_AMF(1:cutOff);

SysLoss_AMF = SysLoss(1:cutOff, :);
SysLoss_AMF_smoothed = SysLoss_smoothed(1:cutOff, :);

% Silica-cladding from AMF
folder = 'Sep_08_2026';

% Import pure PhC data
fileName = strcat(folder,'/phc/a',string(a),'-r',string(r),'-n',string(n),'-',string(copy),'-TE.dat');
PhC_TE_AMF = OpenDAT(fileName);
PhC_TE_AMF = PhC_TE_AMF(1:cutOff, :);

fileName = strcat(folder,'/phc/a',string(a),'-r',string(r),'-n',string(n),'-',string(copy),'-TM.dat');
PhC_TM_AMF = OpenDAT(fileName);
PhC_TM_AMF = PhC_TM_AMF(1:cutOff, :);

% Import W1 data
fileName = strcat(folder,'/dfct/a',string(a),'-r',string(r),'-n',string(n),'-',string(copy),'-TE.dat');
W1_TE_AMF = OpenDAT(fileName);
W1_TE_AMF = W1_TE_AMF(1:cutOff, :);

fileName = strcat(folder,'/dfct/a',string(a),'-r',string(r),'-n',string(n),'-',string(copy),'-TM.dat');
W1_TM_AMF = OpenDAT(fileName);
W1_TM_AMF = W1_TM_AMF(1:cutOff, :);

% Import PBS data
fileName = strcat(folder,'/pbs/a',string(a),'-r',string(r),'-n',string(n),'-',string(copy),'-TE-dir.dat');
TEdir_AMF = OpenDAT(fileName);
TEdir_AMF = TEdir_AMF(1:cutOff, :);

fileName = strcat(folder,'/pbs/a',string(a),'-r',string(r),'-n',string(n),'-',string(copy),'-TE-adj.dat');
TEadj_AMF = OpenDAT(fileName);
TEadj_AMF = TEadj_AMF(1:cutOff, :);

fileName = strcat(folder,'/pbs/a',string(a),'-r',string(r),'-n',string(n),'-',string(copy),'-TM-dir.dat');
TMdir_AMF = OpenDAT(fileName);
TMdir_AMF = TMdir_AMF(1:cutOff, :);

fileName = strcat(folder,'/pbs/a',string(a),'-r',string(r),'-n',string(n),'-',string(copy),'-TM-adj.dat');
TMadj_AMF = OpenDAT(fileName);
TMadj_AMF = TMadj_AMF(1:cutOff, :);

[TE_W1, TM_W1] = plotData(SysLoss_AMF, TE_wg_AMF,TE_in_AMF,TM_wg_AMF,TM_in_AMF, PhC_TE_AMF, PhC_TM_AMF, W1_TE_AMF, W1_TM_AMF, latticeParams);
close all
plotPBSData(SysLoss_AMF, TE_wg_AMF,TE_in_AMF,TM_wg_AMF,TM_in_AMF, TEdir_AMF, TEadj_AMF, TMdir_AMF, TMadj_AMF, latticeParams, TE_W1, TM_W1);
close all

%% Compare the two chip batches

lambda_NRC = SysLoss_NRC(:,1);
lambda_AMF = SysLoss_AMF(:,1);


% waveguide and insertion losses

[TE_wg_NRC_fit, TM_wg_NRC_fit] = DataFit(TE_wg_NRC, TM_wg_NRC, lambda_NRC, 'NRC Waveguide Losses');
[TE_wg_AMF_fit, TM_wg_AMF_fit] = DataFit(TE_wg_AMF, TM_wg_AMF, lambda_AMF, 'NRC Waveguide Losses');
[TE_in_NRC_fit, TM_in_NRC_fit] = DataFit(TE_in_NRC, TM_in_NRC, lambda_NRC, 'NRC Waveguide Losses');
[TE_in_AMF_fit, TM_in_AMF_fit] = DataFit(TE_in_AMF, TM_in_AMF, lambda_AMF, 'NRC Waveguide Losses');

figure
subplot(2,1,1)
hold on
plot(lambda_NRC, TE_wg_NRC_fit, 'LineWidth', 2,'Color',[0 0.4470 0.7410])
plot(lambda_NRC, TM_wg_NRC_fit, 'LineWidth', 2,'Color',[0.8500 0.3250 0.0980])
plot(lambda_AMF, TE_wg_AMF_fit, '--', 'LineWidth', 2,'Color',[0 0.4470 0.7410])
plot(lambda_AMF, TM_wg_AMF_fit, '--', 'LineWidth', 2,'Color',[0.8500 0.3250 0.0980])
hold off
xlabel('Wavelength (nm)')
ylabel('Measured Power (mdB)')
legend('TE (NRC)','TM (NRC)','TE (AMF)','TM (AMF)')
title('Comparison of Waveguide Losses')
xlim([lambda_AMF(1) lambda_AMF(end)])

subplot(2,1,2)
hold on
plot(lambda_NRC, TE_in_NRC_fit, 'LineWidth', 2,'Color',[0 0.4470 0.7410])
plot(lambda_NRC, TM_in_NRC_fit, 'LineWidth', 2,'Color',[0.8500 0.3250 0.0980])
plot(lambda_AMF, TE_in_AMF_fit, '--', 'LineWidth', 2,'Color',[0 0.4470 0.7410])
plot(lambda_AMF, TM_in_AMF_fit, '--', 'LineWidth', 2,'Color',[0.8500 0.3250 0.0980])    
hold off
xlabel('Wavelength (nm)')
ylabel('Measured Power (mdB)')
legend('TE (NRC)','TM (NRC)','TE (AMF)','TM (AMF)')
title('Comparison of Coupling Losses')
xlim([lambda_AMF(1) lambda_AMF(end)])

% PhC transmission

[PhC_TE_NRC_fit, PhC_TM_NRC_fit] = DataFit(10*log10(PhC_TE_NRC(:,2)), 10*log10(PhC_TM_NRC(:,2)), lambda_NRC, 'NRC Waveguide Losses');
[PhC_TE_AMF_fit, PhC_TM_AMF_fit] = DataFit(10*log10(PhC_TE_AMF(:,2)), 10*log10(PhC_TM_AMF(:,2)), lambda_AMF, 'NRC Waveguide Losses');

PhC_TE_NRC = PhC_TE_NRC_fit + SysLoss_NRC_smoothed - TE_wg_NRC_fit - TE_in_NRC_fit;
PhC_TM_NRC = PhC_TM_NRC_fit - (-1) - TM_wg_NRC_fit - TM_in_NRC_fit;
PhC_TE_AMF = PhC_TE_AMF_fit + SysLoss_AMF_smoothed - TE_wg_AMF_fit - TE_in_AMF_fit;
PhC_TM_AMF = PhC_TM_AMF_fit - (-1) - TM_wg_AMF_fit - TM_in_AMF_fit;

figure
hold on
plot(lambda_NRC, PhC_TE_NRC, 'LineWidth', 2,'Color',[0 0.4470 0.7410])
plot(lambda_NRC, PhC_TM_NRC, 'LineWidth', 2,'Color',[0.8500 0.3250 0.0980])
plot(lambda_AMF, PhC_TE_AMF, '--', 'LineWidth', 2,'Color',[0 0.4470 0.7410])
plot(lambda_AMF, PhC_TM_AMF, '--', 'LineWidth', 2,'Color',[0.8500 0.3250 0.0980])
hold off
xlabel('Wavelength (nm)')
ylabel('Measured Power (mdB)')
legend('TE (NRC)','TM (NRC)','TE (AMF)','TM (AMF)')
title('Comparison of PhC Transmission')
xlim([lambda_AMF(1) lambda_AMF(end)])

% line defect transmission

[W1_TE_NRC_fit, W1_TM_NRC_fit] = DataFit(10*log10(W1_TE_NRC(:,2)), 10*log10(W1_TM_NRC(:,2)), lambda_NRC, 'NRC Waveguide Losses');
[W1_TE_AMF_fit, W1_TM_AMF_fit] = DataFit(10*log10(W1_TE_AMF(:,2)), 10*log10(W1_TM_AMF(:,2)), lambda_AMF, 'NRC Waveguide Losses');

figure
hold on
plot(lambda_NRC, W1_TE_NRC_fit + SysLoss_NRC_smoothed - TE_wg_NRC_fit - TE_in_NRC_fit, 'LineWidth', 2,'Color',[0 0.4470 0.7410])
plot(lambda_NRC, W1_TM_NRC_fit - (-1) - TM_wg_NRC_fit - TM_in_NRC_fit, 'LineWidth', 2,'Color',[0.8500 0.3250 0.0980])
plot(lambda_AMF, W1_TE_AMF_fit + SysLoss_AMF_smoothed - TE_wg_AMF_fit - TE_in_AMF_fit, '--', 'LineWidth', 2,'Color',[0 0.4470 0.7410])
plot(lambda_AMF, W1_TM_AMF_fit - (-1) - TM_wg_AMF_fit - TM_in_AMF_fit, '--', 'LineWidth', 2,'Color',[0.8500 0.3250 0.0980])
hold off
xlabel('Wavelength (nm)')
ylabel('Measured Power (mdB)')
legend('TE (NRC)','TM (NRC)','TE (AMF)','TM (AMF)')
title('Comparison of Line-Defect Transmission')
xlim([lambda_AMF(1) lambda_AMF(end)])

% PBS performance
% channel transmission

[TE_dir_NRC_fit, TM_dir_NRC_fit] = DataFit(10*log10(TEdir_NRC(:,2)), 10*log10(TMdir_NRC(:,2)), lambda_NRC, 'NRC Waveguide Losses');
[TE_dir_AMF_fit, TM_dir_AMF_fit] = DataFit(10*log10(TEdir_AMF(:,2)), 10*log10(TMdir_AMF(:,2)), lambda_AMF, 'NRC Waveguide Losses');
[TE_adj_NRC_fit, TM_adj_NRC_fit] = DataFit(10*log10(TEadj_NRC(:,2)), 10*log10(TMadj_NRC(:,2)), lambda_NRC, 'NRC Waveguide Losses');
[TE_adj_AMF_fit, TM_adj_AMF_fit] = DataFit(10*log10(TEadj_AMF(:,2)), 10*log10(TMadj_AMF(:,2)), lambda_AMF, 'NRC Waveguide Losses');

figure
subplot(2,1,1) % Direct channel
hold on
plot(lambda_NRC, TE_dir_NRC_fit + SysLoss_NRC_smoothed - TE_wg_NRC_fit - TE_in_NRC_fit, 'LineWidth', 2,'Color',[0 0.4470 0.7410])
plot(lambda_NRC, TM_dir_NRC_fit - (-1) - TM_wg_NRC_fit - TM_in_NRC_fit, 'LineWidth', 2,'Color',[0.8500 0.3250 0.0980])
plot(lambda_AMF, TE_dir_AMF_fit + SysLoss_AMF_smoothed - TE_wg_AMF_fit - TE_in_AMF_fit, '--', 'LineWidth', 2,'Color',[0 0.4470 0.7410])
plot(lambda_AMF, TM_dir_AMF_fit - (-1) - TM_wg_AMF_fit - TM_in_AMF_fit, '--', 'LineWidth', 2,'Color',[0.8500 0.3250 0.0980])
hold off
xlabel('Wavelength (nm)')
ylabel('Measured Power (mdB)')
legend('TE (NRC)','TM (NRC)','TE (AMF)','TM (AMF)')
title('Comparison of Direct Channel Transmission')
xlim([lambda_AMF(1) lambda_AMF(end)])

subplot(2,1,2) % Adjacent channel
hold on
plot(lambda_NRC, TE_adj_NRC_fit + SysLoss_NRC_smoothed - TE_wg_NRC_fit - TE_in_NRC_fit, 'LineWidth', 2,'Color',[0 0.4470 0.7410])
plot(lambda_NRC, TM_adj_NRC_fit - (-1) - TM_wg_NRC_fit - TM_in_NRC_fit, 'LineWidth', 2,'Color',[0.8500 0.3250 0.0980])
plot(lambda_AMF, TE_adj_AMF_fit + SysLoss_AMF_smoothed - TE_wg_AMF_fit - TE_in_AMF_fit, '--', 'LineWidth', 2,'Color',[0 0.4470 0.7410])
plot(lambda_AMF, TM_adj_AMF_fit - (-1) - TM_wg_AMF_fit - TM_in_AMF_fit, '--', 'LineWidth', 2,'Color',[0.8500 0.3250 0.0980])    
hold off
xlabel('Wavelength (nm)')
ylabel('Measured Power (d)')
legend('TE (NRC)','TM (NRC)','TE (AMF)','TM (AMF)')
title('Comparison of Adjacent Channel Transmission')
xlim([lambda_AMF(1) lambda_AMF(end)])

% ERs

ER_TE_NRC = TE_dir_NRC_fit-TE_adj_NRC_fit;
ER_TM_NRC = TM_adj_NRC_fit-TM_dir_NRC_fit;
ER_TE_AMF = TE_dir_AMF_fit-TE_adj_AMF_fit;
ER_TM_AMF = TM_adj_AMF_fit-TM_dir_AMF_fit;

figure
hold on
plot(lambda_NRC, ER_TE_NRC, 'LineWidth', 2,'Color',[0 0.4470 0.7410])
plot(lambda_NRC, ER_TM_NRC, 'LineWidth', 2,'Color',[0.8500 0.3250 0.0980])
plot(lambda_AMF, ER_TE_AMF, '--', 'LineWidth', 2,'Color',[0 0.4470 0.7410])
plot(lambda_AMF, ER_TM_AMF, '--', 'LineWidth', 2,'Color',[0.8500 0.3250 0.0980])
hold off
xlabel('Wavelength (nm)')
ylabel('Measured Power (mdB)')
legend('TE (NRC)','TM (NRC)','TE (AMF)','TM (AMF)')
title('Comparison of Extinction Ratios')
xlim([lambda_AMF(1) lambda_AMF(end)])

